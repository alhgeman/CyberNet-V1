-- === CORE SYSTEM FUNCTIONS ===
local function isAlive(player)
    if player and player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
        return player.Character:FindFirstChildOfClass("Humanoid").Health > 0
    end
    return false
end

local function isTarget(player)
    if not player or player == Players.LocalPlayer then return false end
    if not isAlive(player) then return false end
    
    if _G.TeamCheck then
        if player.Team == Players.LocalPlayer.Team then
            return false
        end
    end
    return true
end

-- === SICHTBARKEITSPRÜFUNG (für ESP-Farbwechsel) ===
local function isVisible(player)
    local character = player.Character
    if not character then return false end
    local head = character:FindFirstChild("Head")
    if not head then return false end
    
    local camera = Workspace.CurrentCamera
    if not camera then return false end
    
    local origin = camera.CFrame.Position
    local targetPos = head.Position
    local direction = (targetPos - origin).Unit
    local distance = (targetPos - origin).Magnitude
    
    -- Raycast mit Ignorieren des eigenen Charakters
    local ignoreList = {Players.LocalPlayer.Character}
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = ignoreList
    
    local result = Workspace:Raycast(origin, direction * distance, rayParams)
    if result then
        local hit = result.Instance
        -- Wenn der getroffene Teil zum Ziel-Charakter gehört, ist er sichtbar
        if hit and hit:IsDescendantOf(character) then
            return true
        else
            return false
        end
    else
        -- Kein Treffer = direkte Sichtlinie
        return true
    end
end

local function resetHitbox(player)
    pcall(function()
        if player and player.Character and player.Character:FindFirstChild("Head") then
            local head = player.Character.Head
            if head.Size ~= Vector3.new(2, 1, 1) then
                head.Size = Vector3.new(2, 1, 1)
                head.Transparency = 0
                head.BrickColor = BrickColor.new("Medium stone grey")
                head.Material = Enum.Material.Plastic
                head.CanCollide = true
            end
        end
    end)
end

local function removeESP(player)
    pcall(function()
        if player and player.Character then
            local highlight = player.Character:FindFirstChild("ESPHighlight")
            if highlight then highlight:Destroy() end
            
            local head = player.Character:FindFirstChild("Head")
            if head then
                local bGui = head:FindFirstChild("ESP_Billboard")
                if bGui then bGui:Destroy() end
            end
        end
    end)
end

local function applyESP(player)
    pcall(function()
        local character = player.Character
        if not character then return end
        
        -- 1. Outline Highlight
        local highlight = character:FindFirstChild("ESPHighlight")
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "ESPHighlight"
            highlight.FillTransparency = 0.75
            highlight.OutlineTransparency = 0.2
            highlight.Parent = character
        end
        
        -- Farbwechsel basierend auf Sichtbarkeit
        local visible = isVisible(player)
        if visible then
            highlight.FillColor = Color3.fromRGB(255, 0, 0)      -- Rot
            highlight.OutlineColor = Color3.fromRGB(255, 0, 0)  -- Rot
        else
            highlight.FillColor = Color3.fromRGB(0, 255, 136)   -- Grün (normal)
            highlight.OutlineColor = Color3.fromRGB(0, 255, 136)
        end
        
        -- 2. Minimalist Health Bar
        local head = character:FindFirstChild("Head")
        if head then
            local bGui = head:FindFirstChild("ESP_Billboard")
            if not bGui then
                bGui = Instance.new("BillboardGui")
                bGui.Name = "ESP_Billboard"
                bGui.Size = UDim2.new(0, 50, 0, 5)
                bGui.StudsOffset = Vector3.new(0, 1.8, 0)
                bGui.AlwaysOnTop = true
                
                local hBarBg = Instance.new("Frame")
                hBarBg.Name = "HealthBarBg"
                hBarBg.Size = UDim2.new(1, 0, 1, 0)
                hBarBg.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
                hBarBg.BorderSizePixel = 0
                hBarBg.Parent = bGui
                
                local hBarFill = Instance.new("Frame")
                hBarFill.Name = "Fill"
                hBarFill.Size = UDim2.new(1, 0, 1, 0)
                hBarFill.BackgroundColor3 = Color3.fromRGB(0, 255, 136)
                hBarFill.BorderSizePixel = 0
                hBarFill.Parent = hBarBg
                
                local cr1 = Instance.new("UICorner")
                cr1.CornerRadius = UDim.new(1, 0)
                cr1.Parent = hBarBg
                
                local cr2 = Instance.new("UICorner")
                cr2.CornerRadius = UDim.new(1, 0)
                cr2.Parent = hBarFill
                
                bGui.Parent = head
            end
            
            local hBarBg = bGui:FindFirstChild("HealthBarBg")
            if hBarBg then
                local hBarFill = hBarBg:FindFirstChild("Fill")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if hBarFill and humanoid then
                    local percent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    hBarFill.Size = UDim2.new(percent, 0, 1, 0)
                    hBarFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - percent), 255 * percent, 136 * percent)
                end
            end
        end
    end)
end

-- === 2D TRACERS ===
local tracers = {}

local function removeTracer(player)
    if tracers[player] then
        pcall(function() tracers[player]:Destroy() end)
        tracers[player] = nil
    end
end

local function applyTracer(player)
    if not DrawingSupported then return end
    local character = player.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local camera = Workspace.CurrentCamera
    local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
    
    if onScreen then
        if not tracers[player] then
            pcall(function()
                local line = Drawing.new("Line")
                line.Thickness = 1.0
                line.Color = Color3.fromRGB(0, 255, 136)
                line.Transparency = 0.5
                tracers[player] = line
            end)
        end
        
        local line = tracers[player]
        if line then
            pcall(function()
                line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                line.To = Vector2.new(screenPos.X, screenPos.Y)
                line.Visible = true
            end)
        end
    else
        removeTracer(player)
    end
end

-- === GLOBALE HITBOX & FREEZE ===
local function applyGlobalHitbox(player)
    local character = player.Character
    if not character then return end
    
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            if not part:GetAttribute("GlobalOrigSize") then
                part:SetAttribute("GlobalOrigSize", part.Size)
                part:SetAttribute("GlobalOrigTransp", part.Transparency)
                part:SetAttribute("GlobalOrigColor", part.BrickColor)
                part:SetAttribute("GlobalOrigMaterial", part.Material)
            end
            part.Size = Vector3.new(_G.GlobalHitboxSize, _G.GlobalHitboxSize, _G.GlobalHitboxSize)
            part.Transparency = _G.GlobalHitboxTransparency
            part.BrickColor = BrickColor.new("Bright red")
            part.Material = Enum.Material.Neon
            part.CanCollide = true
        end
    end
end

local function resetGlobalHitbox(player)
    local character = player.Character
    if not character then return end
    
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part:GetAttribute("GlobalOrigSize") then
            part.Size = part:GetAttribute("GlobalOrigSize")
            part.Transparency = part:GetAttribute("GlobalOrigTransp")
            part.BrickColor = part:GetAttribute("GlobalOrigColor") or BrickColor.new("Medium stone grey")
            part.Material = part:GetAttribute("GlobalOrigMaterial") or Enum.Material.Plastic
            part:SetAttribute("GlobalOrigSize", nil)
            part:SetAttribute("GlobalOrigTransp", nil)
            part:SetAttribute("GlobalOrigColor", nil)
            part:SetAttribute("GlobalOrigMaterial", nil)
        end
    end
end

local function freezePlayer(player, freeze)
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = freeze and 0 or 16
        humanoid.JumpPower = freeze and 0 or 50
        humanoid.AutoJumpEnabled = not freeze
    end
end

