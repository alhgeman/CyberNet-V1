-- === BACKGROUND RUNTIME ===
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            if isTarget(player) and player.Character then
                -- Kopf-Hitbox
                if player.Character:FindFirstChild("Head") then
                    local head = player.Character.Head
                    if _G.HitboxEnabled then
                        pcall(function()
                            head.Size = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
                            head.Transparency = _G.HitboxTransparency
                            head.BrickColor = BrickColor.new("Really red")
                            head.Material = Enum.Material.Neon
                            head.CanCollide = false
                            head.Massless = true
                        end)
                    else
                        resetHitbox(player)
                    end
                end
                
                -- Globale Hitbox
                if _G.GlobalHitboxEnabled then
                    applyGlobalHitbox(player)
                else
                    resetGlobalHitbox(player)
                end
                
                -- Freeze
                if _G.FreezePlayers then
                    freezePlayer(player, true)
                else
                    freezePlayer(player, false)
                end
                
                -- ESP (mit Sichtbarkeits-Farbwechsel)
                if _G.EspEnabled then
                    applyESP(player)
                else
                    removeESP(player)
                end
                
                -- Tracers
                if _G.TracersEnabled then
                    applyTracer(player)
                else
                    removeTracer(player)
                end
            else
                resetHitbox(player)
                resetGlobalHitbox(player)
                freezePlayer(player, false)
                removeESP(player)
                removeTracer(player)
            end
        end
    end
end)

