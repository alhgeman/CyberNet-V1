RaycastParameters.FilterType = Enum.RaycastFilterType.Exclude

-- Core Helper Functions
local function isAlive(player)
    if not player or not player.Character then return false end
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

local function isTarget(player)
    if not player or player == Players.LocalPlayer then return false end
    if not isAlive(player) then return false end
    
    if Config.TeamCheck and player.Team == Players.LocalPlayer.Team then
        return false
    end
    return true
end

-- Optimized Raycasting Visibility Check
local function isVisible(player)
    local character = player.Character
    if not character then return false end
    
    local head = character:FindFirstChild("Head")
    local camera = Workspace.CurrentCamera
    if not head or not camera then return false end
    
    local origin = camera.CFrame.Position
    local targetPos = head.Position
    local direction = targetPos - origin
    
    local localChar = Players.LocalPlayer.Character
    RaycastParameters.FilterDescendantsInstances = localChar and {localChar} or {}
    
    local result = Workspace:Raycast(origin, direction, RaycastParameters)
    if result then
        return result.Instance:IsDescendantOf(character)
    end
    return true
end

-- Reset Functions with Safe Error Handling
local function resetHitbox(player)
    pcall(function()
        if player and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head and head:GetAttribute("OriginalSize") then
                head.Size = head:GetAttribute("OriginalSize")
                head.Transparency = head:GetAttribute("OriginalTransparency") or 0
                head.BrickColor = head:GetAttribute("OriginalColor") or BrickColor.new("Medium stone grey")
                head.Material = head:GetAttribute("OriginalMaterial") or Enum.Material.Plastic
                head.CanCollide = true
                head:SetAttribute("OriginalSize", nil)
            end
        end
    end)
end

local function resetGlobalHitbox(player)
    pcall(function()
        local character = player and player.Character
        if character then
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") and part:GetAttribute("GlobalOrigSize") then
                    part.Size = part:GetAttribute("GlobalOrigSize")
                    part.Transparency = part:GetAttribute("GlobalOrigTransp") or 0
                    part.BrickColor = part:GetAttribute("GlobalOrigColor") or BrickColor.new("Medium stone grey")
                    part.Material = part:GetAttribute("GlobalOrigMaterial") or Enum.Material.Plastic
                    part:SetAttribute("GlobalOrigSize", nil)
                end
            end
        end
    end)
end

local function freezePlayer(player, freeze)
    pcall(function()
        local character = player and player.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.WalkSpeed = freeze and 0 or 16
                humanoid.JumpPower = freeze and 0 or 50
                humanoid.AutoJumpEnabled = not freeze
            end
        end
    end)
end

local function removeESP(player)
    pcall(function()
        if player and player.Character then
            local highlight = player.Character:FindFirstChild("ESPHighlight")
            if highlight then highlight:Destroy() end
            
            local head = player.Character:FindFirstChild("Head")
            if head then
                local billboard = head:FindFirstChild("ESP_Billboard")
                if billboard then billboard:Destroy() end
            end
        end
    end)
end

local function removeTracer(player)
    if Tracers[player] then
        pcall(function() Tracers[player]:Destroy() end)
        Tracers[player] = nil
    end
end

-- Feature Implementation Functions
local function applyHitbox(player)
    pcall(function()
        local head = player.Character and player.Character:FindFirstChild("Head")
        if head then
            if not head:GetAttribute("OriginalSize") then
                head:SetAttribute("OriginalSize", head.Size)
                head:SetAttribute("OriginalTransparency", head.Transparency)
                head:SetAttribute("OriginalColor", head.BrickColor)
                head:SetAttribute("OriginalMaterial", head.Material)
            end
            head.Size = Vector3.new(Config.HeadSize, Config.HeadSize, Config.HeadSize)
            head.Transparency = Config.HitboxTransparency
            head.BrickColor = BrickColor.new("Really red")
            head.Material = Enum.Material.Neon
            head.CanCollide = false
            head.Massless = true
        end
    end)
end

local function applyGlobalHitbox(player)
    pcall(function()
        local character = player.Character
        if character then
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") then
                    if not part:GetAttribute("GlobalOrigSize") then
                        part:SetAttribute("GlobalOrigSize", part.Size)
                        part:SetAttribute("GlobalOrigTransp", part.Transparency)
                        part:SetAttribute("GlobalOrigColor", part.BrickColor)
                        part:SetAttribute("GlobalOrigMaterial", part.Material)
                    end
                    part.Size = Vector3.new(Config.GlobalHitboxSize, Config.GlobalHitboxSize, Config.GlobalHitboxSize)
                    part.Transparency = Config.GlobalHitboxTransparency
                    part.BrickColor = BrickColor.new("Bright red")
                    part.Material = Enum.Material.Neon
                    part.CanCollide = true
                end
            end
        end
    end)
end

local function applyESP(player)
    pcall(function()
        local character = player.Character
        if not character then return end
        
        local highlight = character:FindFirstChild("ESPHighlight")
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "ESPHighlight"
            highlight.FillTransparency = 0.75
            highlight.OutlineTransparency = 0.2
            highlight.Parent = character
        end
        
        local visible = isVisible(player)
        local color = visible and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 136)
        highlight.FillColor = color
        highlight.OutlineColor = color
        
        local head = character:FindFirstChild("Head")
        if head then
            local billboard = head:FindFirstChild("ESP_Billboard")
            if not billboard then
                billboard = Instance.new("BillboardGui")
                billboard.Name = "ESP_Billboard"
                billboard.Size = UDim2.new(0, 50, 0, 5)
                billboard.StudsOffset = Vector3.new(0, 1.8, 0)
                billboard.AlwaysOnTop = true
                
                local background = Instance.new("Frame")
                background.Name = "HealthBarBg"
                background.Size = UDim2.new(1, 0, 1, 0)
                background.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
                background.BorderSizePixel = 0
                background.Parent = billboard
                
                local fill = Instance.new("Frame")
                fill.Name = "Fill"
                fill.Size = UDim2.new(1, 0, 1, 0)
                fill.BackgroundColor3 = Color3.fromRGB(0, 255, 136)
                fill.BorderSizePixel = 0
                fill.Parent = background
                
                local corner1 = Instance.new("UICorner")
                corner1.CornerRadius = UDim.new(1, 0)
                corner1.Parent = background
                
                local corner2 = Instance.new("UICorner")
                corner2.CornerRadius = UDim.new(1, 0)
                corner2.Parent = fill
                
                billboard.Parent = head
            end
            
            local fill = billboard:FindFirstChild("HealthBarBg") and billboard.HealthBarBg:FindFirstChild("Fill")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if fill and humanoid then
                local percent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                fill.BackgroundColor3 = Color3.fromRGB(255 * (1 - percent), 255 * percent, 136 * percent)
            end
        end
    end)
end

local function applyTracer(player)
    if not DrawingSupported then return end
    pcall(function()
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local camera = Workspace.CurrentCamera
        
        if hrp and camera then
            local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                if not Tracers[player] then
                    local line = Drawing.new("Line")
                    line.Thickness = 1.0
                    line.Color = Color3.fromRGB(0, 255, 136)
                    line.Transparency = 0.5
                    Tracers[player] = line
                end
                
                local line = Tracers[player]
                line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                line.To = Vector2.new(screenPos.X, screenPos.Y)
                line.Visible = true
            else
                removeTracer(player)
            end
        else
            removeTracer(player)
        end
    end)
end

-- Cleanup Handler
local function cleanupPlayer(player)
    removeTracer(player)
    removeESP(player)
    resetHitbox(player)
    resetGlobalHitbox(player)
    freezePlayer(player, false)
end

Players.PlayerRemoving:Connect(cleanupPlayer)

-- Optimized Execution Loops
task.spawn(function()
    while task.wait(Config.UpdateInterval) do
        for _, player in ipairs(Players:GetPlayers()) do
            if isTarget(player) then
                if Config.HitboxEnabled then applyHitbox(player) else resetHitbox(player) end
                if Config.GlobalHitboxEnabled then applyGlobalHitbox(player) else resetGlobalHitbox(player) end
                freezePlayer(player, Config.FreezePlayers)
                if Config.EspEnabled then applyESP(player) else removeESP(player) end
            else
                cleanupPlayer(player)
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if Config.TracersEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if isTarget(player) then
                applyTracer(player)
            else
                removeTracer(player)
            end
        end
    end
end)

