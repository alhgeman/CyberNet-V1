local y = 38
local function mkBtn(label, key, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -16, 0, 28)
    b.Position = UDim2.new(0, 8, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(22, 26, 38)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Parent = main
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local function ref()
        local on = S[key]
        b.Text = (on and "[ON]  " or "[OFF]  ") .. label
        b.BackgroundColor3 = on and Color3.fromRGB(0, 120, 95) or Color3.fromRGB(22, 26, 38)
    end
    b.MouseButton1Click:Connect(function()
        S[key] = not S[key]
        if cb then cb(S[key]) end
        ref()
    end)
    ref()
    y = y + 33
end

local function mkSlider(label, key, min, max, step)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -16, 0, 16)
    l.Position = UDim2.new(0, 8, 0, y)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.Gotham
    l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextColor3 = Color3.fromRGB(180, 190, 200)
    l.Parent = main
    y = y + 16
    local function ref() l.Text = "  " .. label .. ": " .. tostring(S[key]) end
    local mn = Instance.new("TextButton")
    mn.Size = UDim2.new(0, 36, 0, 24)
    mn.Position = UDim2.new(0, 8, 0, y)
    mn.Text = "-"
    mn.Font = Enum.Font.GothamBlack
    mn.TextSize = 14
    mn.BackgroundColor3 = Color3.fromRGB(22, 26, 38)
    mn.TextColor3 = Color3.fromRGB(255, 255, 255)
    mn.Parent = main
    Instance.new("UICorner", mn).CornerRadius = UDim.new(0, 6)
    local pl = Instance.new("TextButton")
    pl.Size = UDim2.new(0, 36, 0, 24)
    pl.Position = UDim2.new(1, -44, 0, y)
    pl.Text = "+"
    pl.Font = Enum.Font.GothamBlack
    pl.TextSize = 14
    pl.BackgroundColor3 = Color3.fromRGB(22, 26, 38)
    pl.TextColor3 = Color3.fromRGB(255, 255, 255)
    pl.Parent = main
    Instance.new("UICorner", pl).CornerRadius = UDim.new(0, 6)
    mn.MouseButton1Click:Connect(function()
        S[key] = math.clamp(math.floor((S[key] - step) * 100) / 100, min, max)
        ref()
    end)
    pl.MouseButton1Click:Connect(function()
        S[key] = math.clamp(math.floor((S[key] + step) * 100) / 100, min, max)
        ref()
    end)
    ref()
    y = y + 28
end

mkBtn("Auto Spam", "Spam")
mkBtn("No Cooldown", "NoCD", function(v) setNoCD(v) end)
mkBtn("Auto Chase", "Chase")
mkSlider("Speed", "Speed", 0.03, 1, 0.02)
mkSlider("Range", "Range", 20, 300, 10)

main.Size = UDim2.new(0, 230, 0, y + 8)
print("CYBERNET AUTO release loaded")
