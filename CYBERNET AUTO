local LP = game.Players.LocalPlayer
local PG = LP:WaitForChild("PlayerGui")
getgenv = getgenv or (function() return _G end)
getgenv()._cnRun = false
task.wait(0.3)
pcall(function() local o = PG:FindFirstChild("CyberNetAuto") if o then o:Destroy() end end)
if getgenv()._cnNoCDConn then pcall(function() getgenv()._cnNoCDConn:Disconnect() end) getgenv()._cnNoCDConn = nil end

local S = {Spam = true, Speed = 0.12, Range = 60, Chase = false, NoCD = true}
getgenv().CyberNet = S
getgenv()._cnRun = true

local function setNoCD(on)
    if getgenv()._cnNoCDConn then pcall(function() getgenv()._cnNoCDConn:Disconnect() end) getgenv()._cnNoCDConn = nil end
    if not on then return end
    local c = LP.Character
    if c then
        for _, n in ipairs({"Cooldown","CMoveCooldown","XMoveCooldown","RMoveCooldown","FMoveCooldown","GMoveCooldown","M1MoveCooldown","BoostCooldown"}) do
            local t = c:FindFirstChild(n)
            if t then pcall(function() t:Destroy() end) end
        end
    end
    local dc = game.Workspace:FindFirstChild("developer_Controls")
    if dc and dc:FindFirstChild("cooldownsOn") then dc.cooldownsOn.Value = false end
    if c then
        getgenv()._cnNoCDConn = c.ChildAdded:Connect(function(child)
            if not getgenv().CyberNet.NoCD then return end
            if child.Name:find("Cooldown") then task.wait() pcall(function() child:Destroy() end) end
        end)
    end
end
setNoCD(true)

LP.CharacterAdded:Connect(function()
    task.wait(1)
    if getgenv().CyberNet and getgenv().CyberNet.NoCD then setNoCD(true) end
end)

task.spawn(function()
    local ability = game.ReplicatedStorage.game_folder.remote.ability_remote
    local moveset = LP:WaitForChild("Settings"):WaitForChild("moveset")
    local tick = 1
    while getgenv()._cnRun do
        if S.Spam then
            local ms = "Viltrumite"
            pcall(function() ms = moveset.Value end)
            local best, bestDist = nil, S.Range
            pcall(function()
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, plr in ipairs(game.Players:GetPlayers()) do
                        if plr ~= LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                            local hum = plr.Character:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 and not plr.Character:FindFirstChild("IFrame") then
                                local d = (plr.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                                if d < bestDist then best, bestDist = plr.Character, d end
                            end
                        end
                    end
                end
            end)
            if S.Chase and best then
                pcall(function()
                    local hrp = LP.Character.HumanoidRootPart
                    local t = best.HumanoidRootPart.Position
                    hrp.CFrame = CFrame.new(t + Vector3.new(0, 2, 3), t)
                end)
            end
            ability:FireServer(ms, "FlightCombat", best, "StartCombo", tick)
            if best then task.wait(0.03) ability:FireServer(ms, "FlightCombat", best, "NormalComboHit", tick) end
            tick = tick + 1
            if tick > 4 then tick = 1 end
            task.wait(math.clamp(S.Speed, 0.03, 1))
        else
            task.wait(0.2)
        end
        if S.NoCD then
            local dc = game.Workspace:FindFirstChild("developer_Controls")
            if dc and dc:FindFirstChild("cooldownsOn") and dc.cooldownsOn.Value ~= false then
                dc.cooldownsOn.Value = false
            end
        end
    end
end)

